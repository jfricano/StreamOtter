{
  "name": "@streamotter/workbench",
  "version": "0.1.0-rc.3",
  "description": "StreamOtter workbench (static assets): served by `streamotter dev` from the loopback management origin, or hosted under a site route through the workbench host contract (WHC-1).",
  "keywords": ["streamotter", "kafka", "realtime", "workbench", "developer-tools"],
  "homepage": "https://github.com/jfricano/StreamOtter/tree/main/apps/workbench#readme",
  "bugs": { "url": "https://github.com/jfricano/StreamOtter/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/jfricano/StreamOtter.git", "directory": "apps/workbench" },
  "license": "MIT",
  "author": "Orca Solutions",
  "type": "module",
  "exports": {
    "./host": "./dist/workbench-host.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./host": "./dist/workbench-host.json",
      "./dist/*": "./dist/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "@streamotter/client": "workspace:*",
    "@streamotter/contracts": "workspace:*",
    "esbuild": "0.28.2"
  }
}
