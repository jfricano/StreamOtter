---
/** A plain docs page: an eyebrow, a heading and lede, then the page's sections. */
import Base from "./Base.astro";
import { RELEASE } from "../site.ts";
interface Props { title: string; description: string; eyebrow?: string; noindex?: boolean }
const { title, description, eyebrow = "StreamOtter docs", noindex = false } = Astro.props;
---
<Base title={`${title} · StreamOtter Docs`} description={description} noindex={noindex}>
  <div class="wrap page">
    <header class="page-head"><p class="eyebrow">{eyebrow} <span>· v{RELEASE}</span></p><h1>{title}</h1><p class="lede">{description}</p></header>
    <slot />
  </div>
</Base>
<style>
.page { padding-block: 48px 80px; }
.page-head { display: grid; gap: 18px; max-width: 850px; margin-bottom: 40px; }
.page-head .eyebrow span { text-transform: none; }
.page-head h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
.page :global(section) { margin-block: 40px; display: grid; gap: 16px; }
.page :global(h2) { font-size: clamp(1.6rem, 3vw, 2.1rem); }
</style>
