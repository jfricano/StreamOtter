---
/**
 * One guide from docs/guides/, rendered from the repository's Markdown. Its own first heading is
 * the page's h1; its links to other repository files open on GitHub at the build's ref
 * (the release tag, or main in a preview).
 */
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { GUIDES, LINKS, REF, VERSION_LABEL } from "../../site.ts";

export async function getStaticPaths() {
  const entries = await getCollection("guides");
  const missing = GUIDES.filter(guide => !entries.some(entry => entry.id === guide.slug)).map(guide => guide.slug);
  if (missing.length > 0) throw new Error(`Guides: docs/guides/ has no ${missing.join(", ")}.`);
  return GUIDES.map((guide, index) => ({
    params: { slug: guide.slug },
    props: { entry: entries.find(entry => entry.id === guide.slug)!, guide, previous: GUIDES[index - 1], next: GUIDES[index + 1] }
  }));
}

const { entry, guide, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
const title = headings.find(heading => heading.depth === 1)?.text ?? guide.label;
const sections = headings.filter(heading => heading.depth === 2);
---
<Base title={`${title} · StreamOtter Docs`} description={guide.summary}>
  <div class="wrap guide-layout">
    <nav class="guide-side" aria-labelledby="guide-list">
      <p class="eyebrow" id="guide-list">Guides <span>· {VERSION_LABEL}</span></p>
      <ol>{GUIDES.map(item => <li><a href={`/guides/${item.slug}/`} aria-current={item.slug === guide.slug ? "page" : undefined}>{item.label}</a></li>)}</ol>
      {sections.length > 0 && (
        <>
          <p class="eyebrow" id="guide-toc">On this page</p>
          <ul aria-labelledby="guide-toc">{sections.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
        </>
      )}
    </nav>
    <article class="prose">
      <Content />
      <nav class="pager" aria-label="Previous and next guide">
        {previous ? <a href={`/guides/${previous.slug}/`}><span>Previous</span>{previous.label}</a> : <span />}
        {next && <a class="next" href={`/guides/${next.slug}/`}><span>Next</span>{next.label}</a>}
      </nav>
      <p class="source muted"><a href={`${LINKS.github}/blob/${REF}/docs/guides/${guide.slug}.md`}>This guide on GitHub ↗</a></p>
    </article>
  </div>
</Base>
<style>
.guide-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 48px; padding-block: 40px 80px; align-items: start; }
.guide-side { position: sticky; top: 88px; display: grid; gap: 10px; max-height: calc(100vh - 112px); overflow-y: auto; font-size: .93rem; }
.guide-side .eyebrow span { text-transform: none; }
.guide-side :is(ol, ul) { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 2px; }
.guide-side a { display: block; padding: 4px 8px; border-radius: 6px; color: var(--ink-2); text-decoration: none; }
.guide-side a:hover { background: var(--surface-2); color: var(--ink); }
.guide-side a[aria-current="page"] { background: var(--surface-2); color: var(--ink); font-weight: 700; }
.pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); }
.pager a { display: grid; gap: 2px; text-decoration: none; font-weight: 700; }
.pager a span { font: 600 .74rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
.pager .next { text-align: right; margin-left: auto; }
.source { margin-top: 20px; font-size: .92rem; }
@media (max-width: 900px) {
  .guide-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  /* The guide comes first; the list of guides and its contents follow it. */
  .guide-side { position: static; max-height: none; order: 2; padding-top: 24px; border-top: 1px solid var(--line); }
}
.prose { min-width: 0; max-width: 78ch; font-size: 17px; }
.prose :global(h1) { font-size: clamp(2.2rem, 4.6vw, 3.2rem); margin-bottom: 24px; }
.prose :global(h2) { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-top: 48px; margin-bottom: 14px; }
.prose :global(h3) { font-size: 1.2rem; margin-top: 32px; margin-bottom: 10px; }
.prose :global(:is(p, ul, ol, pre, table, blockquote)) { margin-block: 0 16px; }
.prose :global(:is(ul, ol)) { padding-left: 1.4em; display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
.prose :global(li) { min-width: 0; }
.prose :global(pre) { overflow-x: auto; padding: 16px 18px; border-radius: var(--radius); font-size: .86rem; line-height: 1.6; }
.prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
.prose { overflow-wrap: break-word; }
.prose :global(:not(pre) > code) { overflow-wrap: anywhere; }
.prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .94rem; }
.prose :global(:is(th, td)) { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
.prose :global(th) { background: var(--surface-2); }
.prose :global(blockquote) { padding: 12px 18px; border-left: 4px solid var(--accent); background: var(--surface-2); border-radius: 0 var(--radius) var(--radius) 0; }
.prose :global(blockquote p:last-child) { margin-bottom: 0; }
.prose :global(img) { max-width: 100%; height: auto; }
</style>
