{
  "name": "@streamotter/client",
  "version": "0.2.0-rc.1",
  "description": "StreamOtter browser SDK: subscribe to state channels with authoritative snapshots, revision-ordered updates, and explicit live/stale states over Socket.IO, with React hooks.",
  "keywords": ["streamotter", "kafka", "socket.io", "websocket", "realtime", "live-data", "state-sync", "browser", "typescript", "react"],
  "homepage": "https://github.com/jfricano/StreamOtter/tree/main/packages/client#readme",
  "bugs": { "url": "https://github.com/jfricano/StreamOtter/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/jfricano/StreamOtter.git", "directory": "packages/client" },
  "license": "MIT",
  "author": "Orca Solutions",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "streamotter-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "streamotter-source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "prepack": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    }
  },
  "dependencies": {
    "@streamotter/contracts": "workspace:*",
    "socket.io-client": "4.8.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
