{
  "name": "@streamotter/gateway",
  "version": "0.1.0-rc.2",
  "description": "StreamOtter Node.js gateway: Kafka and fixture sources, application-owned access handlers, snapshot synchronization, and bounded Socket.IO delivery.",
  "keywords": ["streamotter", "kafka", "kafkajs", "socket.io", "websocket", "realtime", "live-data", "state-sync", "gateway", "typescript"],
  "homepage": "https://github.com/jfricano/StreamOtter/tree/main/packages/gateway#readme",
  "bugs": { "url": "https://github.com/jfricano/StreamOtter/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/jfricano/StreamOtter.git", "directory": "packages/gateway" },
  "license": "MIT",
  "author": "Orca Solutions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "streamotter-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./management": {
      "streamotter-source": "./src/management/index.ts",
      "types": "./dist/management/index.d.ts",
      "default": "./dist/management/index.js"
    },
    "./internals": {
      "streamotter-source": "./src/internals.ts",
      "types": "./dist/internals.d.ts",
      "default": "./dist/internals.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./management": {
        "types": "./dist/management/index.d.ts",
        "default": "./dist/management/index.js"
      },
      "./internals": {
        "types": "./dist/internals.d.ts",
        "default": "./dist/internals.js"
      }
    }
  },
  "dependencies": {
    "@streamotter/contracts": "workspace:*",
    "kafkajs": "2.2.4",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
