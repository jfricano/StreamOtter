{
  "name": "@streamotter/cli",
  "version": "0.1.0-rc.3",
  "description": "StreamOtter command-line interface: init, validate, generate, dev (with the local workbench), and start.",
  "keywords": ["streamotter", "kafka", "socket.io", "realtime", "live-data", "state-sync", "cli", "codegen", "typescript"],
  "homepage": "https://github.com/jfricano/StreamOtter/tree/main/packages/cli#readme",
  "bugs": { "url": "https://github.com/jfricano/StreamOtter/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/jfricano/StreamOtter.git", "directory": "packages/cli" },
  "license": "MIT",
  "author": "Orca Solutions",
  "type": "module",
  "bin": {
    "streamotter": "./bin/streamotter.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "streamotter-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@streamotter/contracts": "workspace:*",
    "@streamotter/gateway": "workspace:*",
    "@streamotter/workbench": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
