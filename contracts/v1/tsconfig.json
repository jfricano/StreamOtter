{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ],
    "customConditions": [
      "streamotter-source"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "./*.ts"
  ]
}
